[package]
name = "custom-vercodable-eval"
version = "0.0.0"
edition = "2024"
publish = false

[workspace]

[dependencies]
vercode = { path = "@VERCODE_PATH@" }
hashed-type-def = { version = "=0.1.2", features = ["derive"] }
zerocopy = { version = "0.8", features = ["derive"] }
bincode = "=1.3.3"
serde = { version = "1", features = ["derive"] }
